# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ──────────────────────────────────────────────────────────────────────────────
# PostgreSQL — Neon (https://neon.tech)
# 1. Sign up at neon.tech
# 2. Create a project → Copy the connection string from the dashboard
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@ep-xxxxx.us-east-1.aws.neon.tech/reachbox?sslmode=require

# ──────────────────────────────────────────────────────────────────────────────
# Redis — Upstash (https://upstash.com)
# 1. Sign up at upstash.com → Create a Redis database
# 2. Go to your database → "Connect" tab → Copy the connection string
# 3. Use the "rediss://" URL (with TLS) shown in the dashboard
#
# Example: rediss://default:AbCdEfGh@us1-xxxx-xxxxx.upstash.io:6380
# ──────────────────────────────────────────────────────────────────────────────
REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6380


# ──────────────────────────────────────────────────────────────────────────────
# Google OAuth
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized redirect URI: http://localhost:3001/api/auth/google/callback
# ──────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ──────────────────────────────────────────────────────────────────────────────
# Frontend URL (for CORS + OAuth redirect)
# ──────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# BullMQ Worker Settings
# ──────────────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# ──────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────────────────────────────────────
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ──────────────────────────────────────────────────────────────────────────────
# Ethereal Email — auto-created on first run (see server console for credentials)
# Optionally hardcode a pre-created account to reuse across restarts
# ──────────────────────────────────────────────────────────────────────────────
ETHEREAL_USER=
ETHEREAL_PASS=

# ──────────────────────────────────────────────────────────────────────────────
# Resend Email API (Recommended for Cloud Production — https://resend.com)
# Uses HTTPS (Port 443), bypassing cloud provider SMTP port 587 restrictions.
# 1. Sign up at resend.com → Create API Key (starts with re_...)
# 2. Verify your custom domain at resend.com/domains (DKIM, SPF, DMARC)
# 3. If set, Resend REST API is used automatically over HTTPS instead of Ethereal SMTP
# ──────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@send.yourdomain.com
